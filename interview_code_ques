// Q3.  Implement dynmaic casting

#include <iostream>
using namespace std;

class Base
{
public:
    virtual void show()
    {
        cout << "Base class" << endl;
    }
};

class Derived : public Base
{
public:
    void show()
    {
        cout << "Derived class" << endl;
    }

    void display()
    {
        cout << "Derived class function" << endl;
    }
};

int main()
{
    Base *b;
    Derived d;

    b = &d;

    b->show(); // Runtime polymorphism

    // Dynamic Casting
    Derived *dp = dynamic_cast<Derived *>(b);

    if (dp != NULL)
    {
        dp->display();
    }
    else
    {
        cout << "Casting failed" << endl;
    }

    return 0;
}
