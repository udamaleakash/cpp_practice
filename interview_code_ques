#include <iostream>
using namespace std;

void sort_arr(int arr[], int len)
{

    int l = 0;
    int m = 0;
    int h = len - 1;

    while (m <= h)
    {

        if (arr[m] == 0)
        {

            if (arr[l] > arr[m])
            {
                int t = arr[l];
                arr[l] = arr[m];
                arr[m] = t;
            }
            l++;
            m++;
        }
        else if (arr[m] == 1)
        {
            m++;
        }
        else
        {
            if (arr[m] > arr[h])
            {
                int t2 = arr[m];
                arr[m] = arr[h];
                arr[h] = t2;
            }
            h--;
        }
    }
    for (int i = 0; i < len; i++)
    {
        cout << arr[i] << " " << endl;
    }
}

int main()
{
    int arr[] = {0, 1, 1, 1, 2, 0, 2, 2, 0, 1, 0};
    int len = sizeof(arr) / sizeof(arr[0]);

    sort_arr(arr, len);
    return 0;
}

